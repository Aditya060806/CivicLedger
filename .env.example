# CivicLedger Environment Configuration

# Database Configuration
# Set to false for development (uses localStorage)
# Set to true for production (uses PostgreSQL)
USE_DATABASE=false

# PostgreSQL connection (only needed when USE_DATABASE=true)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/civicledger

# ICP Configuration (Optional - for blockchain integration)
VITE_IC_HOST=https://ic0.app
VITE_INTERNET_IDENTITY_URL=https://identity.ic0.app

# Canister IDs (Optional - replace with your deployed canister IDs)
VITE_SMART_POLICY_CANISTER_ID=rrkah-fqaaa-aaaaa-aaaaq-cai
VITE_COMPLAINT_HANDLER_CANISTER_ID=ryjl3-tyaaa-aaaaa-aaaba-cai
VITE_DAO_MANAGER_CANISTER_ID=r7inp-6aaaa-aaaaa-aaabq-cai
VITE_FUND_TRACKER_CANISTER_ID=rno2w-sqaaa-aaaaa-aaacq-cai
VITE_INDIA_HUB_CANISTER_ID=qoctq-giaaa-aaaam-qaeea-cai
VITE_BLOCKCHAIN_VERIFIER_CANISTER_ID=r4rm6-rqaaa-aaaaa-aaaiq-cai
VITE_AI_OPTIMIZER_CANISTER_ID=r5aec-rqaaa-aaaaa-aaajq-cai

# AI API Keys (Optional - for enhanced AI features)
