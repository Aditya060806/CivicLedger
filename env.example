# ICP Configuration
VITE_IC_HOST=https://ic0.app
VITE_INTERNET_IDENTITY_URL=https://identity.ic0.app

# Canister IDs (Replace with actual IDs after deployment)
# For local development, these will be generated after running 'dfx deploy'
VITE_SMART_POLICY_CANISTER_ID=your_smart_policy_canister_id
VITE_INDIA_HUB_CANISTER_ID=your_india_hub_canister_id
VITE_BLOCKCHAIN_VERIFIER_CANISTER_ID=your_blockchain_verifier_canister_id
VITE_AI_OPTIMIZER_CANISTER_ID=your_ai_optimizer_canister_id

# Additional canisters from your project
VITE_COMPLAINT_HANDLER_CANISTER_ID=your_complaint_handler_canister_id
VITE_DAO_MANAGER_CANISTER_ID=your_dao_manager_canister_id
VITE_FUND_TRACKER_CANISTER_ID=your_fund_tracker_canister_id

# Local development settings (uncomment for local testing)
# VITE_IC_HOST=http://127.0.0.1:4943
# VITE_INTERNET_IDENTITY_URL=http://127.0.0.1:4943/?canisterId=rdmx6-jaaaa-aaaaa-aaadq-cai
